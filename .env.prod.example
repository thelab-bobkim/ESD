# 서버에서 이 파일을 .env.prod 로 복사한 뒤 실제 값으로 반드시 변경하세요.
DB_PASSWORD=CONFIGURABLE_change_me_strong_password
JWT_SECRET=CONFIGURABLE_change_me_random_long_string

# 2026-10-01: 다우오피스 자동 동기화를 배제한다. 기본 false — 스케줄러(조직도 자동 동기화·휴가 스크래핑)를
# 아예 띄우지 않는다. 다시 쓰려면 true로 바꾸고 재배포한 뒤, 정책값(DAUOFFICE_AUTO_SYNC_ENABLED /
# DAUOFFICE_LEAVE_SCRAPE_ENABLED)도 함께 켜야 한다(이중 잠금). 관리자 화면의 수동 동기화 버튼은 이 값과 무관하게 동작한다.
DAUOFFICE_SCHEDULERS_ENABLED=false

# 다우오피스 OpenAPI 연동 (선택 — 값을 안 채우면 다우오피스 동기화 기능만 비활성화됨)
DAUOFFICE_CLIENT_ID=
DAUOFFICE_CLIENT_SECRET=
DAUOFFICE_API_URL=https://api.daouoffice.com
DAUOFFICE_TLS_INSECURE=false

# 브라우저 푸시 알림(오전 9시 미출근 알림 등). 아래는 미리 생성해둔 키 쌍입니다 — 그대로 쓰셔도 되고,
# 원하시면 서버에서 `node -e "console.log(require('web-push').generateVAPIDKeys())"`로 새로 만들어도 됩니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 2026-09-30: JWT_SECRET은 예시값 그대로면 서버가 기동하지 않습니다. 생성 예) openssl rand -hex 32

# 데이터 손실이 생기는 스키마 변경(컬럼 삭제 등)을 허용할지 — 기본 false(안전). 정말 필요할 때만 한 번 true로 배포 후 되돌리세요.
ALLOW_DB_DATA_LOSS=false

# 재택 위치 감사 좌표 보관일수는 관리자 정책값 REMOTE_AUDIT_COORD_RETENTION_DAYS로 180일 이하로만 줄일 수 있습니다.

# 운영 배포 시 실제 서비스 주소로 설정 권장. 2026-09-30부터 비워두면 "다른 출처 전부 거부"(같은 출처인 이 앱 화면은 정상 동작)
# 예: CORS_ORIGIN=https://esd-yourcompany.duckdns.org
CORS_ORIGIN=

# 고객사 위치관리 화면의 지도검색 기능용 카카오맵 JavaScript 키 (developers.kakao.com에서 무료 발급)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 출퇴근 인사말에 날씨를 반영하기 위한 OpenWeatherMap 키 (openweathermap.org에서 무료 발급, 선택 —
# 값을 안 채우면 날씨 문구 없이 요일/시간대 인사말만 나온다). 예시 파일이 아니라 .env.prod에 채워넣을 것.
OPENWEATHER_API_KEY=

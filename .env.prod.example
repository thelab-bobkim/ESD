# 서버에서 이 파일을 .env.prod 로 복사한 뒤 실제 값으로 반드시 변경하세요.
DB_PASSWORD=CONFIGURABLE_change_me_strong_password
JWT_SECRET=CONFIGURABLE_change_me_random_long_string

# 다우오피스 OpenAPI 연동 (선택 — 값을 안 채우면 다우오피스 동기화 기능만 비활성화됨)
DAUOFFICE_CLIENT_ID=
DAUOFFICE_CLIENT_SECRET=
DAUOFFICE_API_URL=https://api.daouoffice.com
DAUOFFICE_TLS_INSECURE=false

# 서버에서 이 파일을 .env.prod 로 복사한 뒤 실제 값으로 반드시 변경하세요.
DB_PASSWORD=CONFIGURABLE_change_me_strong_password
JWT_SECRET=CONFIGURABLE_change_me_random_long_string

# 다우오피스 OpenAPI 연동 (선택 — 값을 안 채우면 다우오피스 동기화 기능만 비활성화됨)
DAUOFFICE_CLIENT_ID=
DAUOFFICE_CLIENT_SECRET=
DAUOFFICE_API_URL=https://api.daouoffice.com
DAUOFFICE_TLS_INSECURE=false

# 브라우저 푸시 알림(오전 9시 미출근 알림 등). 아래는 미리 생성해둔 키 쌍입니다 — 그대로 쓰셔도 되고,
# 원하시면 서버에서 `node -e "console.log(require('web-push').generateVAPIDKeys())"`로 새로 만들어도 됩니다.
VAPID_PUBLIC_KEY=BClw-cvqmCYzCp-TKrPH9WHp-Uzim7hHnWr-cHvvRNIm_0Hw1yD5FQwTGLOTuLO3t544BsLe77vBA5wZxn03Y5s
VAPID_PRIVATE_KEY=t5pDPrUx0YAg_2uuvXUyIIIiN0_sZ2j8P7Tbf6_OK3s
VAPID_SUBJECT=mailto:admin@example.com

# 운영 배포 시 실제 서비스 주소로 반드시 설정(비워두면 전체 출처 허용 — HTTPS 붙인 뒤에는 꼭 채울 것)
# 예: CORS_ORIGIN=https://esd-yourcompany.duckdns.org
CORS_ORIGIN=

DATABASE_URL=postgresql://app_user:CONFIGURABLE_change_me@localhost:5432/employee_status?schema=public
JWT_SECRET=CONFIGURABLE_change_me_in_env
PORT=4000
# 운영 배포 시 실제 서비스 주소로 반드시 설정(비워두면 전체 출처 허용 — 개발용 기본값)
CORS_ORIGIN=

# 다우오피스 OpenAPI 연동 (선택 — 값이 없으면 다우오피스 동기화 기능만 비활성화되고 나머지는 정상 동작)
DAUOFFICE_CLIENT_ID=
DAUOFFICE_CLIENT_SECRET=
DAUOFFICE_API_URL=https://api.daouoffice.com
# true로 두면 TLS 인증서 검증을 끈다(AMS 원본 기본값). 특별한 사유가 없으면 비워두거나 false 권장.
DAUOFFICE_TLS_INSECURE=false

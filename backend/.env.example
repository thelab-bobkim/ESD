DATABASE_URL=postgresql://app_user:CONFIGURABLE_change_me@localhost:5432/employee_status?schema=public
JWT_SECRET=CONFIGURABLE_change_me_in_env
PORT=4000
# 운영 배포 시 실제 서비스 주소로 반드시 설정(비워두면 전체 출처 허용 — 개발용 기본값)
CORS_ORIGIN=

# 다우오피스 OpenAPI 연동 (선택 — 값이 없으면 다우오피스 동기화 기능만 비활성화되고 나머지는 정상 동작)
DAUOFFICE_CLIENT_ID=
DAUOFFICE_CLIENT_SECRET=
DAUOFFICE_API_URL=https://api.daouoffice.com
# true로 두면 TLS 인증서 검증을 끈다(AMS 원본 기본값). 특별한 사유가 없으면 비워두거나 false 권장.
DAUOFFICE_TLS_INSECURE=false

# 2026-09-18: 다우오피스 "전사 휴가현황" 화면 스크래핑용 로그인 계정 (선택 — 값이 없으면 휴가
# 스크래핑 기능만 비활성화되고 나머지는 정상 동작). 전사 휴가현황을 볼 수 있는 계정으로 설정할 것.
DAUOFFICE_SCRAPE_USERNAME=
DAUOFFICE_SCRAPE_PASSWORD=
# 다우오피스 포털 주소가 다르면 변경(기본값: https://dsti.daouoffice.com)
DAUOFFICE_PORTAL_URL=https://dsti.daouoffice.com

# 브라우저 푸시 알림(오전 9시 미출근 알림 등) — 값이 없으면 푸시 기능만 비활성화되고 나머지는 정상 동작
# 아래 명령어로 한 번 생성해서 넣으면 됨: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

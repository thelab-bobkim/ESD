// Prisma schema — 전직원 상황판 및 근로시간 통합관리 시스템 (MVP)
// 상세 설명은 /docs/DB_SCHEMA.md 참조

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DepartmentType {
  HQ_SALES
  HQ_ENGINEER
  HQ_ETC
  RESIDENT
}

// 데이터 출처 — 수동입력 vs 다우오피스 자동동기화 (User, AttendanceRecord 공용)
enum DataSource {
  MANUAL
  DAUOFFICE
}

enum WorkType {
  HQ_FLEX
  HQ_FIXED
  RESIDENT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum RoleCode {
  EMPLOYEE
  TEAM_LEAD
  HR_ADMIN
  SYSTEM_ADMIN
  PILOT_MANAGER
}

enum AttendanceStatus {
  HQ_WORKING
  RESIDENT_ONSITE
  OFFSITE
  MEETING
  MOVING
  REMOTE
  NIGHT_WORK
  // 2026-09-06: 주말(토/일) 근무 전용 상태 — 주말에는 이 상태만 등록 가능하고 나머지는 막는다
  // (attendance.routes.ts의 요일 기준 게이트 참고). DB에 이 값을 먼저 추가해야 하므로 배포 시
  // "ALTER TYPE "AttendanceStatus" ADD VALUE IF NOT EXISTS 'WEEKEND_WORK';"를 먼저 실행할 것.
  WEEKEND_WORK
  ALT_DAY_OFF
  ON_LEAVE
  CLIENT_MEETING
  CLIENT_WORK
  BUSINESS_TRIP
}

enum StatusSource {
  WEB
  MOBILE
  SYSTEM
}

enum NightWorkStatus {
  IN_PROGRESS
  COMPLETED
}

enum LeaveConversionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  OVERTIME
  NIGHT_WORK
  LEAVE_CONVERSION
  ATTENDANCE_CORRECTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PolicyValueType {
  BOOLEAN
  NUMBER
  STRING
  JSON
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum FeedbackCategory {
  BUG
  UX
  POLICY
  OTHER
}

enum AuditActionType {
  VIEW
  STATUS_CHANGE
  APPROVE
  REJECT
  CORRECT
  POLICY_CHANGE
  LOCATION_DETAIL_VIEW
}

model Department {
  id        String          @id @default(uuid())
  name      String          @unique
  // 실제 회사 조직은 90여개 팀명을 그대로 쓰므로, type은 고정 필수값이 아니라
  // "본사/상주" 같은 정책 판단용 참고 태그로만 사용한다(선택값).
  type      DepartmentType?
  parentId  String?
  parent    Department?    @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[]   @relation("DeptHierarchy")
  users     User[]
  policyOverrides PolicySetting[]

  @@map("departments")
}

model Client {
  id      String @id @default(uuid())
  name    String
  address String
  // 고객사 방문(도착체크/미팅/작업) 시 GPS 위치 대조용 — 관리자가 직접 입력(지도에서 좌표 조회 후 입력).
  // 미입력 상태면 위치 대조를 안 하고 그냥 통과시킨다.
  latitude  Float?
  longitude Float?

  users            User[]
  residentCheckins ResidentCheckin[]

  @@map("clients")
}

model User {
  id                String           @id @default(uuid())
  employeeNo        String           @unique @map("employee_no")
  name              String
  // 다우오피스 동기화 계정은 이메일 정보가 없으므로 선택값으로 변경.
  // 로그인은 email 또는 employeeNo(=다우오피스 loginId) 중 하나로 가능하다.
  email             String?          @unique
  passwordHash      String           @map("password_hash")
  departmentId      String           @map("department_id")
  department        Department       @relation(fields: [departmentId], references: [id])
  assignedClientId  String?          @map("assigned_client_id")
  assignedClient    Client?          @relation(fields: [assignedClientId], references: [id])
  workType          WorkType         @map("work_type")
  employmentStatus  EmploymentStatus @default(ACTIVE) @map("employment_status")
  // 다우오피스 연동 관련 필드
  dauofficeUserId   String?          @unique @map("dauoffice_user_id")
  dataSource        DataSource       @default(MANUAL) @map("data_source")
  // 다우오피스 동기화로 새로 생성된 계정은 true로 시작 — 최초 로그인 시 비밀번호 변경을 강제한다.
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  // 고객사 방문 위치대조 기능에 대한 동의 시각(최초 1회 명시적 동의) — null이면 아직 미동의.
  locationConsentAt  DateTime?       @map("location_consent_at")
  // 개인정보 수집·이용 동의 시각(최초 1회 명시적 동의) — null이면 아직 미동의.
  // 2026-08-30부터 앱 사용의 필수 전제조건(위치정보 동의와 함께)으로 운영 — index.tsx MandatoryConsentGate 참고.
  privacyConsentAt   DateTime?       @map("privacy_consent_at")
  // 2026-08-30 보안점검: 비밀번호 변경 시 이 값을 올려서, 그 전에 발급된 JWT를 전부 무효화한다
  // (JWT는 상태를 안 갖는 토큰이라, 이 값이 없으면 비번을 바꿔도 예전 토큰이 만료 전까지 계속 유효했음).
  // requireAuth가 매 요청마다 토큰 속 tokenVersion과 이 값을 비교한다 — common/guards/auth.ts 참고.
  tokenVersion       Int             @default(0) @map("token_version")
  // 2026-08-30 보안점검: 계정 단위 로그인 잠금(무차별 대입 방지, IP 기준 rate-limit과는 별개).
  // 연속 실패 시 잠기고, 로그인 성공하면 둘 다 초기화된다 — auth.routes.ts /login 참고.
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime?       @map("locked_until")
  // 2026-09-04: 로그인 성공 시각 기록 — "이 직원이 앱을 실제로 쓰고 있는지"를 관리자가 확인할
  // 방법이 없어서 추가(한 번도 로그인 안 한 사람/오래 안 켠 사람을 admin/board-scope 화면에서
  // 보여주기 위함). null이면 아직 한 번도 로그인한 적이 없다는 뜻.
  lastLoginAt        DateTime?       @map("last_login_at")
  // 2026-09-04: 회사가 다우오피스 전체 조직도가 아니라 특정 부서/인원만 시범적으로 상황판·출퇴근
  // 현황에 표시하길 원해서 추가 — true인 사람만 전사 상황판(dashboard.routes.ts)과 출퇴근 현황
  // (reports.routes.ts)에 나타난다. 다우오피스 동기화로 새로 생기는 계정은 기본 false로 시작해서,
  // 관리자가 admin/board-scope 화면에서 부서 단위 또는 개별로 명시적으로 켜야 노출된다.
  includedInBoard    Boolean         @default(false) @map("included_in_board")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  userRoles              UserRole[]
  attendanceRecords      AttendanceRecord[]
  statusChangeLogs       StatusChangeLog[]
  residentCheckins       ResidentCheckin[]
  nightWorkSessions      NightWorkSession[]
  leaveBalances          LeaveBalance[]
  leaveConversionRequests LeaveConversionRequest[]
  pilotGroupMembers      PilotGroupMember[]
  pilotFeedback          PilotFeedback[] @relation("PilotFeedbackAuthor")
  pilotFeedbackResolved  PilotFeedback[] @relation("PilotFeedbackResolvedBy")
  effortLogs             EffortLog[]
  businessTripLogs       BusinessTripLog[]
  pushSubscriptions      PushSubscription[]
  approvalRequestsMade   ApprovalRequest[] @relation("Requester")
  approvalRequestsDecided ApprovalRequest[] @relation("Approver")
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  // 2026-09-15: 관리자→직원 간단 메시지(위치/근태 이슈 등 확인 요청용) — 받는 사람 쪽만 관계로 둔다.
  // 보낸 관리자는 이름만 스냅샷으로 남기고(AdminMessage.sentByName) 별도 관계를 두지 않는다
  // (같은 User 모델을 두 번 참조하려면 @relation 이름 구분이 필요해지는데, 발신 이력 조회 화면이
  // 아직 없어 굳이 관계로 만들 실익이 적다 — 필요해지면 그때 추가).
  receivedAdminMessages  AdminMessage[]

  @@map("users")
}

model Role {
  id    String     @id @default(uuid())
  code  RoleCode   @unique
  name  String
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id])
  roleId              String   @map("role_id")
  role                Role     @relation(fields: [roleId], references: [id])
  scopeDepartmentId   String?  @map("scope_department_id")

  @@unique([userId, roleId, scopeDepartmentId])
  @@map("user_roles")
}

model AttendanceRecord {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id])
  workDate            DateTime  @map("work_date") @db.Date
  clockInAt           DateTime? @map("clock_in_at")
  clockOutAt          DateTime? @map("clock_out_at")
  totalWorkedMinutes  Int?      @map("total_worked_minutes")
  isCorrected         Boolean   @default(false) @map("is_corrected")
  correctionReason    String?   @map("correction_reason")
  // 다우오피스 동기화로 채워진 값인지 여부. 수동 정정본(MANUAL)은 동기화가 덮어쓰지 않는다.
  dataSource          DataSource @default(MANUAL) @map("data_source")
  // 퇴근 시점 위치 — 좌표는 저장하지 않고, 역지오코딩된 "주소 텍스트"만 저장한다(직원 동의 필요, core_principles 원칙 유지).
  clockOutLocation    String?    @map("clock_out_location")
  // 퇴근 위치가 왜 비어있는지(권한거부/타임아웃/미동의 등)를 구분해서 저장한다 —
  // 상황판에서 "빈 값"과 "확인했지만 못 구했음"을 구분해서 보여주기 위함.
  clockOutLocationStatus LocationCaptureStatus? @map("clock_out_location_status")
  // 최소근무시간(기본 8시간) 미충족 상태에서 조기퇴근한 경우 본인이 입력한 사유.
  // 하드블록 대신 "사유 입력 + 즉시 확정" 방식으로 바꾸면서 추가 — 부족분은 주간 집계에서
  // 자연스럽게(다른 날 초과분과 합산되어) 반영되므로 별도 상쇄 로직은 두지 않는다.
  earlyLeaveReason String? @map("early_leave_reason")

  breakSessions BreakSession[]
  correctionRequests AttendanceCorrectionRequest[]

  @@unique([userId, workDate])
  @@map("attendance_records")
}

// 퇴근 시 위치정보를 못 가져온 이유. OK 이외의 값은 clockOutLocation이 비어있는 이유를 설명한다.
enum LocationCaptureStatus {
  OK
  NO_CONSENT
  PERMISSION_DENIED
  TIMEOUT
  UNSUPPORTED
  GEOCODE_FAILED
}

// 퇴근을 못 누르고 날짜가 넘어간 근태를, 직원이 스스로 시각/사유를 입력해 정정 신청하는 건.
// 시스템이 임의로 퇴근시각을 확정하지 않는다는 원칙(대체휴무 자동전환과 동일한 원칙)에 따라,
// 반드시 직원 본인의 신청 + 승인권자의 승인(ApprovalRequest, type=ATTENDANCE_CORRECTION)을 거쳐야
// attendance_records에 반영된다 (approval.routes.ts 참고).
model AttendanceCorrectionRequest {
  id                 String                     @id @default(uuid())
  userId             String                     @map("user_id")
  user               User                       @relation(fields: [userId], references: [id])
  attendanceRecordId String                     @map("attendance_record_id")
  attendanceRecord   AttendanceRecord           @relation(fields: [attendanceRecordId], references: [id])
  proposedClockOutAt DateTime                   @map("proposed_clock_out_at")
  reason             String
  status             AttendanceCorrectionStatus @default(PENDING)
  createdAt          DateTime                   @default(now()) @map("created_at")

  approvalRequest ApprovalRequest?

  @@map("attendance_correction_requests")
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model BreakSession {
  id                 String           @id @default(uuid())
  attendanceRecordId String           @map("attendance_record_id")
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  startAt            DateTime         @map("start_at")
  endAt              DateTime?        @map("end_at")

  @@map("break_sessions")
}

model StatusChangeLog {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  status    AttendanceStatus
  changedAt DateTime         @default(now()) @map("changed_at")
  note      String?
  source    StatusSource     @default(WEB)
  // 고객사미팅/고객사작업 등록 시 GPS 위치대조 결과. 원본 좌표는 저장하지 않고 결과만 남긴다.
  locationMatch          Boolean? @map("location_match")
  locationDistanceMeters Int?     @map("location_distance_meters")
  // 2026-09-16: 그 순간 GPS가 스스로 보고한 오차범위(미터) — 프론트(geolocation.ts)는 이미 계산해
  // 갖고 있었는데 서버로 전송되지 않고 있었다(위치 미확인/불일치 개선 1순위). locationMatch 판정 시
  // "거리 - 오차범위 <= 반경"으로 반영하고(common/location.ts), 상황판에서도 "위치 불일치인데
  // 오차범위 자체가 컸는지"를 구분해 보여주는 데 쓴다. 좌표와 마찬가지로 판정에만 쓰는 값이라 그대로
  // 남겨도 원본 위치를 역추적할 수 없어 위치정보 최소수집 원칙에 어긋나지 않는다.
  locationAccuracyMeters Int?     @map("location_accuracy_meters")
  // 원격/현장 여부 — 고객사미팅/고객사작업/야간작업 등록 시 필수 입력.
  // 상태 종류와 무관하게 이 테이블 하나로 조회하므로(EffortLog/NightWorkSession은 상태별로 나뉘어 있음),
  // "직출/직퇴 시 최종 퇴근 위치 필수" 판단(퇴근 처리 로직)이 여기 값을 기준으로 한다.
  siteType  SiteType? @map("site_type")
  // 고객사미팅/고객사작업 등록 시 위치 확보가 왜 안 됐는지(권한거부/타임아웃/미동의 등).
  // "GPS 확보 실패는 하루 1회만 봐주고, 그 다음부터는 위치가 실제로 일치해야 등록을 허용"하는
  // 정책 판단에 쓴다(attendance.routes.ts 참고) — clock_out_location_status와 같은 목적.
  locationCaptureStatus LocationCaptureStatus? @map("location_capture_status")

  @@map("status_change_logs")
}

// 원격근무 vs 고객사 현장 — 직출/직퇴(본사 미경유) 시 이동시간이 근로시간에 섞이지 않도록
// 최종 퇴근 위치를 필수로 받아야 하는지 판단하는 데 쓰인다(ONSITE인 경우만 해당).
enum SiteType {
  REMOTE
  ONSITE
}

model ResidentCheckin {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id])
  clientId        String    @map("client_id")
  client          Client    @relation(fields: [clientId], references: [id])
  checkinAt       DateTime  @default(now()) @map("checkin_at")
  lastConfirmedAt DateTime  @default(now()) @map("last_confirmed_at")
  // 도착체크 시 GPS 위치대조 결과. 원본 좌표는 저장하지 않고 결과만 남긴다.
  locationMatch          Boolean? @map("location_match")
  locationDistanceMeters Int?     @map("location_distance_meters")
  // 2026-09-16: StatusChangeLog와 동일한 목적 — GPS 오차범위를 판정에 반영하기 위해 추가.
  locationAccuracyMeters Int?     @map("location_accuracy_meters")

  @@map("resident_checkins")
}

model NightWorkSession {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id])
  startedAt     DateTime        @map("started_at")
  endedAt       DateTime?       @map("ended_at")
  workedMinutes Int?            @map("worked_minutes")
  status        NightWorkStatus @default(IN_PROGRESS)
  note          String?

  leaveConversionRequest LeaveConversionRequest?

  @@map("night_work_sessions")
}

model LeaveType {
  id   String @id @default(uuid())
  code String @unique // ALT_DAY_OFF, COMP_LEAVE, ANNUAL ...
  name String

  leaveBalances LeaveBalance[]
  leaveConversionRequests LeaveConversionRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  leaveTypeId    String    @map("leave_type_id")
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  balanceMinutes Int       @default(0) @map("balance_minutes")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, leaveTypeId])
  @@map("leave_balances")
}

model LeaveConversionRequest {
  id                     String                @id @default(uuid())
  userId                 String                @map("user_id")
  user                   User                  @relation(fields: [userId], references: [id])
  sourceNightWorkSessionId String?             @unique @map("source_night_work_session_id")
  sourceNightWorkSession NightWorkSession?     @relation(fields: [sourceNightWorkSessionId], references: [id])
  requestedLeaveTypeId   String                @map("requested_leave_type_id")
  requestedLeaveType     LeaveType             @relation(fields: [requestedLeaveTypeId], references: [id])
  convertedMinutes       Int                   @map("converted_minutes")
  status                 LeaveConversionStatus @default(DRAFT)
  createdAt              DateTime              @default(now()) @map("created_at")

  approvalRequest ApprovalRequest?

  @@map("leave_conversion_requests")
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  type        ApprovalType
  referenceId String         @map("reference_id")
  requesterId String         @map("requester_id")
  requester   User           @relation("Requester", fields: [requesterId], references: [id])
  approverId  String?        @map("approver_id")
  approver    User?          @relation("Approver", fields: [approverId], references: [id])
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now()) @map("requested_at")
  decidedAt   DateTime?      @map("decided_at")
  comment     String?

  leaveConversionRequestId String?                 @unique @map("leave_conversion_request_id")
  leaveConversionRequest   LeaveConversionRequest?  @relation(fields: [leaveConversionRequestId], references: [id])

  attendanceCorrectionRequestId String?                       @unique @map("attendance_correction_request_id")
  attendanceCorrectionRequest   AttendanceCorrectionRequest?  @relation(fields: [attendanceCorrectionRequestId], references: [id])

  @@map("approval_requests")
}

model PolicySetting {
  id                 String          @id @default(uuid())
  key                String
  value              String
  valueType          PolicyValueType @map("value_type")
  scopeDepartmentId  String?         @map("scope_department_id")
  scopeDepartment    Department?     @relation(fields: [scopeDepartmentId], references: [id])
  description        String?
  updatedBy          String?         @map("updated_by")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@unique([key, scopeDepartmentId])
  @@map("policy_settings")
}

model AlertRule {
  id      String  @id @default(uuid())
  code    String  @unique // NO_CLOCK_IN / LONG_WORKING / NIGHT_WORK_NOT_CONVERTED / STATUS_NOT_CONFIRMED
  enabled Boolean @default(true)

  @@map("alert_rules")
}

model Alert {
  id         String        @id @default(uuid())
  ruleCode   String        @map("rule_code")
  userId     String        @map("user_id")
  relatedId  String?       @map("related_id")
  severity   AlertSeverity @default(WARNING)
  createdAt  DateTime      @default(now()) @map("created_at")
  resolvedAt DateTime?     @map("resolved_at")

  @@map("alerts")
}

model PilotGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date

  members  PilotGroupMember[]
  feedback PilotFeedback[]

  @@map("pilot_groups")
}

model PilotGroupMember {
  id           String     @id @default(uuid())
  pilotGroupId String     @map("pilot_group_id")
  pilotGroup   PilotGroup @relation(fields: [pilotGroupId], references: [id])
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])

  @@unique([pilotGroupId, userId])
  @@map("pilot_group_members")
}

model PilotFeedback {
  id           String           @id @default(uuid())
  pilotGroupId String           @map("pilot_group_id")
  pilotGroup   PilotGroup       @relation(fields: [pilotGroupId], references: [id])
  userId       String           @map("user_id")
  user         User             @relation("PilotFeedbackAuthor", fields: [userId], references: [id])
  category     FeedbackCategory
  content      String
  createdAt    DateTime         @default(now()) @map("created_at")
  // 2026-09-14: 관리자 피드백함에서 조치 완료된 항목을 따로 표시해달라는 요청 — alerts 테이블의
  // resolvedAt과 동일한 패턴(별도 상태 컬럼 대신 "처리된 시각"만 남김, null이면 미처리).
  // 누가 처리했는지도 같이 남겨서 관리자 화면에 표시한다.
  resolvedAt       DateTime? @map("resolved_at")
  resolvedByUserId String?   @map("resolved_by_user_id")
  resolvedBy       User?     @relation("PilotFeedbackResolvedBy", fields: [resolvedByUserId], references: [id])

  @@map("pilot_feedback")
}

// 감사로그: 논리적으로 분리된 관심사 — append-only, 애플리케이션에서 UPDATE/DELETE 미제공
model AuditLog {
  id           String          @id @default(uuid())
  actorUserId  String?         @map("actor_user_id")
  actionType   AuditActionType @map("action_type")
  targetType   String          @map("target_type")
  targetId     String?         @map("target_id")
  beforeValue  Json?           @map("before_value")
  afterValue   Json?           @map("after_value")
  ipAddress    String?         @map("ip_address")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ===== 다우오피스(Daou Office) 연동 =====

// OAuth2 client_credentials 액세스 토큰 캐시 (AMS의 DauofficeToken과 동일한 목적)
model DauofficeToken {
  id          String   @id @default(uuid())
  accessToken String   @map("access_token")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("dauoffice_tokens")
}

// 다우오피스 조직도 API가 부서를 정확히 안 내려주는 계정에 대한 수동 보정값.
// (AMS의 하드코딩된 DEPT_MAP을 정책값 분리 원칙에 따라 DB 테이블로 이전한 것 — 관리자가
// 화면에서 수정 가능하도록 하기 위함이며, 코드에 하드코딩하지 않는다.)
model DauofficeDepartmentOverride {
  id             String   @id @default(uuid())
  dauofficeLoginId String @unique @map("dauoffice_login_id")
  departmentName String   @map("department_name")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("dauoffice_department_overrides")
}

// ===== 공수(工數) 관리 =====
// 고객사 미팅/작업 상태를 등록할 때, "무슨 프로젝트에 얼마나 시간을 썼는지"를 구조화된 데이터로
// 남긴다. status_change_logs.note는 사람이 읽기 좋은 요약 문자열일 뿐이고, 실제 집계(주/월별,
// 프로젝트별 공수)는 이 테이블을 기준으로 한다.
model EffortLog {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  workDate    DateTime  @map("work_date") @db.Date
  clientName  String    @map("client_name")
  projectName String    @map("project_name")
  workType    String    @map("work_type") // 정기점검/신규설치/장애대응/미팅/기타
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  minutes     Int?      // endTime이 없으면(진행중) null
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  // 2026-09-15: 이 기록이 어떤 상태(고객사작업/고객사미팅/재택/주말작업)에서 등록됐는지 남긴다.
  // "진행중(endTime null)"으로 남겨둔 기록을 나중에 이어받아 완료 처리할 때, 같은 상태에서 만든
  // 기록만 찾아 이어받기 위해 필요하다(effort-helpers.ts recordEffort 참고) — 이 컬럼이 없으면
  // 예를 들어 고객사미팅 진행중 기록을 고객사작업 완료 등록이 잘못 이어받아버릴 수 있다.
  sourceStatus String?  @map("source_status")

  @@map("effort_logs")
}

// ===== 브라우저 푸시 알림 =====
// "오전 9시까지 출근/재택 등록 안 하면 알림" 기능을 위한 구독 정보.
// 웹 표준 Push API(VAPID) 방식이라 안드로이드는 브라우저에서 바로, iOS는 PWA로 홈화면에
// 추가한 뒤에만 동작한다(애플 정책).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

// 관리자 ↔ 직원 간 짧은 메시지(양방향). 2026-09-15: 상황판에서 "위치 불일치/미확인" 등으로
// 표시된 직원을 관리자가 눈으로 확인만 하고 따로 연락할 방법이 없었다(직원→관리자 피드백함의
// 반대 방향으로 시작). 상황판의 직원 아바타(동그라미)를 눌러 짧은 메시지를 보내면, 등록된 푸시
// 구독으로 즉시 알림이 가고(common/push.ts sendPushToUser 재사용), 상황판 앱(index.tsx)에도
// 안 읽은 메시지가 배너로 표시된다. 이후 직원도 그 배너에서 바로 답장할 수 있게 확장했다
// (senderIsAdmin으로 방향 구분) — 근태 기록과는 무관한 단순 알림이라 별도 승인 흐름 없이
// 바로 전달된다. userId는 항상 "이 대화의 직원 쪽"을 가리킨다(관리자가 보냈든 직원이 보냈든).
model AdminMessage {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id])
  message       String
  // true=관리자가 보냄, false=직원이 보낸 답장.
  senderIsAdmin Boolean   @default(true) @map("sender_is_admin")
  // 보낸 사람 이름 스냅샷(관계 없이 문자열로만 남김 — 위 User.receivedAdminMessages 주석 참고).
  // 관리자가 보냈으면 그 관리자 이름, 직원이 보냈으면 본인 이름.
  sentByName    String    @map("sent_by_name")
  // 받는 쪽이 확인한 시각 — senderIsAdmin=true면 직원이, false면 관리자가 확인한 시각.
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("admin_messages")
}

// ===== 출장 =====
// 다른 상태와 달리 여러 날에 걸칠 수 있고 사전에 계획된 정보(목적지/기간/목적)라 별도 모델로 관리한다.
model BusinessTripLog {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  destination String
  purpose     String
  startAt     DateTime  @map("start_at")
  endAt       DateTime? @map("end_at") // 복귀 예정(또는 실제 복귀) 일시. 아직 모르면 비워둠.
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("business_trip_logs")
}

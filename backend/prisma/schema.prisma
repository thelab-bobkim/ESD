// ===== 다우오피스(Daou Office) 연동 =====

// OAuth2 client_credentials 액세스 토큰 캐시 (AMS의 DauofficeToken과 동일한 목적)
model DauofficeToken {
  id          String   @id @default(uuid())
  accessToken String   @map("access_token")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("dauoffice_tokens")
}

// 다우오피스 조직도 API가 부서를 정확히 안 내려주는 계정에 대한 수동 보정값.
// (AMS의 하드코딩된 DEPT_MAP을 정책값 분리 원칙에 따라 DB 테이블로 이전한 것 — 관리자가
// 화면에서 수정 가능하도록 하기 위함이며, 코드에 하드코딩하지 않는다.)
model DauofficeDepartmentOverride {
  id             String   @id @default(uuid())
  dauofficeLoginId String @unique @map("dauoffice_login_id")
  departmentName String   @map("department_name")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("dauoffice_department_overrides")
}

// ===== 공수(工數) 관리 =====
// 고객사 미팅/작업 상태를 등록할 때, "무슨 프로젝트에 얼마나 시간을 썼는지"를 구조화된 데이터로
// 남긴다. status_change_logs.note는 사람이 읽기 좋은 요약 문자열일 뿐이고, 실제 집계(주/월별,
// 프로젝트별 공수)는 이 테이블을 기준으로 한다.
model EffortLog {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  workDate    DateTime  @map("work_date") @db.Date
  clientName  String    @map("client_name")
  projectName String    @map("project_name")
  workType    String    @map("work_type") // 정기점검/신규설치/장애대응/미팅/기타
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  minutes     Int?      // endTime이 없으면(진행중) null — 직원이 등록한 원본 시간, 점심/이동시간 미차감
  // 2026-09-18: "실 공수시간 자동 산정"(경영관리부 요청) — minutes(원본)에서 정책에 정한 점심시간대와
  // 실제로 겹치는 시간만큼 뺀 값(effort-helpers.ts recordEffort, attendance-helpers.ts
  // lunchOverlapMinutes 참고). 원본은 감사·검증용으로 그대로 두고, 공수비용 산정 등 실제 업무에는
  // 이 값을 우선 쓴다(reports.routes.ts). 이 필드 추가 이전 기록은 null이며, 그 경우 화면/집계에서
  // minutes(원본)로 자동 대체한다.
  actualMinutes Int?    @map("actual_minutes")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  // 2026-09-15: 이 기록이 어떤 상태(고객사작업/고객사미팅/재택/주말작업)에서 등록됐는지 남긴다.
  // "진행중(endTime null)"으로 남겨둔 기록을 나중에 이어받아 완료 처리할 때, 같은 상태에서 만든
  // 기록만 찾아 이어받기 위해 필요하다(effort-helpers.ts recordEffort 참고) — 이 컬럼이 없으면
  // 예를 들어 고객사미팅 진행중 기록을 고객사작업 완료 등록이 잘못 이어받아버릴 수 있다.
  sourceStatus String?  @map("source_status")

  @@map("effort_logs")
}

// ===== 다우오피스 "전사 휴가현황" 스크래핑 =====
// 2026-09-18: 다우오피스 공식 API(attnd-v2/attnd)로는 휴가 여부를 구분할 수 없다는 게 이미
// 확인돼서(dauoffice.routes.ts 2026-09-04 기록 — dayWorkStatusCode 등이 이 계정에서 전부 null로만
// 내려옴) headless 브라우저로 "전사 휴가현황" 화면을 직접 읽어와 채운다(leave-scraper.ts).
// 관리자 요청으로, 직원의 실시간 상태값(StatusChangeLog)은 건드리지 않고 상황판에 "오늘의
// 휴가자"를 별도로 얹어 보여주는 용도로만 쓴다 — 그래서 User와 정식 관계(@relation)는 두지
// 않고, 매칭에 성공하면 User.id를 스냅샷으로만 저장한다(표시 전용 데이터라 User 삭제·변경
// 이력과 얽히지 않게 하기 위함).
model DauofficeLeaveEntry {
  id            String    @id @default(uuid())
  workDate      DateTime  @db.Date @map("work_date") // 휴가 사용일(하루 단위 — 여러 날짜에 걸친 휴가는 날짜별로 나눠 저장)
  userId        String?   @map("user_id")
  employeeNoRaw String?   @map("employee_no_raw")
  nameRaw       String    @map("name_raw")
  // 멱등성 키(@@unique)에 쓰이는 값이라 항상 문자열로 정규화한다("" = 부서 미기재) — null을 쓰면
  // Postgres UNIQUE 제약에서 NULL끼리 서로 다른 값으로 취급돼 중복 행이 생길 수 있다.
  departmentRaw String    @default("") @map("department_raw")
  leaveType     String    @map("leave_type") // 원본 표기(연차/기타휴가 등)
  durationLabel String    @map("duration_label") // 종일/오전반차/오후반차/반반차/기타
  startTime     DateTime? @map("start_time")
  endTime       DateTime? @map("end_time")
  matched       Boolean   @default(false)
  scrapedAt     DateTime  @default(now()) @map("scraped_at")

  // 같은 사람의 같은 날짜·같은 휴가유형은 하루 두 번(오전10시/오후1시) 스크래핑해도 한 줄로
  // 유지되게(덮어쓰기) 하는 멱등성 키.
  @@unique([workDate, nameRaw, departmentRaw, leaveType])
  @@map("dauoffice_leave_entries")
}

// ===== 브라우저 푸시 알림 =====
// "오전 9시까지 출근/재택 등록 안 하면 알림" 기능을 위한 구독 정보.
// 웹 표준 Push API(VAPID) 방식이라 안드로이드는 브라우저에서 바로, iOS는 PWA로 홈화면에
// 추가한 뒤에만 동작한다(애플 정책).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

// 관리자 ↔ 직원 간 짧은 메시지(양방향). 2026-09-15: 상황판에서 "위치 불일치/미확인" 등으로
// 표시된 직원을 관리자가 눈으로 확인만 하고 따로 연락할 방법이 없었다(직원→관리자 피드백함의
// 반대 방향으로 시작). 상황판의 직원 아바타(동그라미)를 눌러 짧은 메시지를 보내면, 등록된 푸시
// 구독으로 즉시 알림이 가고(common/push.ts sendPushToUser 재사용), 상황판 앱(index.tsx)에도
// 안 읽은 메시지가 배너로 표시된다. 이후 직원도 그 배너에서 바로 답장할 수 있게 확장했다
// (senderIsAdmin으로 방향 구분) — 근태 기록과는 무관한 단순 알림이라 별도 승인 흐름 없이
// 바로 전달된다. userId는 항상 "이 대화의 직원 쪽"을 가리킨다(관리자가 보냈든 직원이 보냈든).
model AdminMessage {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id])
  message       String
  // true=관리자가 보냄, false=직원이 보낸 답장.
  senderIsAdmin Boolean   @default(true) @map("sender_is_admin")
  // 보낸 사람 이름 스냅샷(관계 없이 문자열로만 남김 — 위 User.receivedAdminMessages 주석 참고).
  // 관리자가 보냈으면 그 관리자 이름, 직원이 보냈으면 본인 이름.
  sentByName    String    @map("sent_by_name")
  // 받는 쪽이 확인한 시각 — senderIsAdmin=true면 직원이, false면 관리자가 확인한 시각.
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("admin_messages")
}

// ===== 출장 =====
// 다른 상태와 달리 여러 날에 걸칠 수 있고 사전에 계획된 정보(목적지/기간/목적)라 별도 모델로 관리한다.
model BusinessTripLog {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  destination String
  purpose     String
  startAt     DateTime  @map("start_at")
  endAt       DateTime? @map("end_at") // 복귀 예정(또는 실제 복귀) 일시. 아직 모르면 비워둠.
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("business_trip_logs")
}

// ===== 야간·주말작업 보고서(메일) =====
// 2026-09-25: 김형태 대표이사 요청 — 엔지니어들이 아웃룩 '받은편지함 > 야간작업및 주말작업' 폴더로 보내는
// 자기보고 메일을 매번 직접 열어보지 않고도 TSB 관리자 화면에서 한눈에 볼 수 있게 하기 위한 표.
// 주의: 위의 NightWorkSession(직원이 앱에서 직접 "야간근무 시작/종료"를 눌러 대체휴무로 전환하는 사내
// 근무기록)과는 완전히 별개의 데이터다 — 이쪽은 아웃룩 메일 원문을 그대로 옮겨 적은 것일 뿐, 앱에서
// 상태변경을 트리거하거나 근태/공수에 반영되지 않는다(참고용 열람 전용).
// 데이터는 관리자가 직접 입력하지 않고, Claude(외부 자동화, Microsoft 365 연동)가 아웃룩을 읽어
// POST /api/v1/night-work-mail/sync 로 주기적으로(매주 월요일/매월 1일 예정) 밀어넣는다 — 그래서 일반
// 로그인 토큰이 아니라 NIGHT_WORK_MAIL_SYNC_KEY(.env.prod) 고정 키로 그 엔드포인트만 별도 인증한다.
// 필드는 메일 형식이 사람마다 제각각이라(자유서식) 최대한 원문 그대로 저장하고 구조화/정제는 하지 않는다.
// tsbLocationVerified는 향후 TSB의 GPS 위치대조 실데이터와 교차검증할 때 채울 자리로, 지금은 항상 null이다.
model NightWorkMailReport {
  id                     String    @id @default(uuid())
  // 메일 한 통에 고객사 작업이 여러 건 적혀있으면 건별로 행을 나눠 저장한다(0부터 시작). 같은 메일을
  // 다시 동기화해도 (mailInternetMessageId, itemIndex) 조합이 같으면 upsert로 덮어쓸 뿐 중복 생성되지 않는다.
  mailInternetMessageId String    @map("mail_internet_message_id")
  itemIndex              Int       @default(0) @map("item_index")
  kind                   String    @map("kind") // "NIGHT"(야간작업) | "WEEKEND"(주말작업)
  workDate               DateTime  @map("work_date") @db.Date // 메일 제목 기준 작업일
  reporterName           String    @map("reporter_name")
  reporterEmail          String    @map("reporter_email")
  clientNameRaw          String    @map("client_name_raw") // 메일 원문의 "고객사" 표기 그대로(정제하지 않음)
  location               String?   @map("location")
  workTimeRaw            String?   @map("work_time_raw") // 메일 원문의 시간 표기 그대로(형식이 제각각이라 구조화하지 않음)
  workContent            String?   @map("work_content")
  workers                String?   @map("workers") // 쉼표로 구분한 작업인원 이름 원문
  note                   String?   @map("note") // 자동추출 중 발견한 이상(날짜 불일치, 고객사명 표기 혼재 등) 메모
  tsbLocationVerified    Boolean?  @map("tsb_location_verified") // GPS 위치대조 연동 전이라 현재는 항상 null
  mailReceivedAt         DateTime  @map("mail_received_at")
  mailWebLink            String?   @map("mail_web_link")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([mailInternetMessageId, itemIndex])
  @@index([workDate])
  @@map("night_work_mail_reports")
}

// ===== 일일업무일지 =====
// 2026-09-26: 김형태 대표이사 요청 — "매일 업무 마감을 일일업무일지로" 진행하기 위한 표.
// 1단계(강제 마감): 자동초안 없이, 퇴근 시 "이슈/특이사항"과 "내일 예정 업무" 두 줄만 필수로
// 받는다(attendance.routes.ts /clock-out에서 함께 upsert). 2단계(자동초안): StatusChangeLog/
// EffortLog/NightWorkMailReport에서 오늘치 데이터를 모아 9개 표준 필드를 미리 채워준다
// (daily-work-log.routes.ts GET /draft). 3단계(관리자 열람): night-work-mail 관리자 화면과 같은
// 패턴으로 목록·주간/월간 집계를 제공한다(daily-work-log.routes.ts GET /admin/*).
// 하루 1건 — 같은 날 다시 제출하면(퇴근 정정 등) upsert로 덮어쓴다(AttendanceRecord와 동일한
// @@unique 패턴).
model DailyWorkLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id])
  workDate DateTime @map("work_date") @db.Date

  // 오늘 근무형태에 따라 간단형/상세형 중 어느 쪽으로 작성됐는지(2단계 자동판단 결과) — 관리자
  // 화면에서 필터링·구분 표시하는 데 쓴다.
  formType DailyWorkLogFormType @default(SIMPLE) @map("form_type")
  // 오늘의 대표 근무형태 스냅샷(마지막 상태, 한글 라벨) — 근태 판정과는 무관한 표시·집계 전용.
  workTypeSnapshot String? @map("work_type_snapshot")
  // 방문 고객사/현장 — 여러 곳이면 쉼표로 구분(2단계 자동초안이 EffortLog/NightWorkMailReport에서 수집).
  visitedClients String? @map("visited_clients")
  // 주요 작업내용 — 자동초안을 기반으로 본인이 자유롭게 수정 가능.
  workContent String? @map("work_content")
  // 이슈 및 특이사항 — 1단계부터 필수(퇴근 시 반드시 입력해야 그날이 마감됨).
  issues String @map("issues")
  // 후속조치/미해결 건 — 선택 입력(상세형에서 주로 사용).
  followUp String? @map("follow_up")
  // 내일 예정 업무 — 1단계부터 필수(퇴근 시 반드시 입력해야 그날이 마감됨).
  tomorrowPlan String @map("tomorrow_plan")
  // 지원요청/공유사항 — 선택 입력.
  supportRequest String? @map("support_request")
  // 오늘 총 근무시간(분) — 퇴근 처리 시 AttendanceRecord.totalWorkedMinutes 스냅샷.
  totalWorkedMinutes Int? @map("total_worked_minutes")
  // 오늘 실공수(고객사 작업 등) 시간(분) — EffortLog.actualMinutes 합계 스냅샷.
  actualEffortMinutes Int? @map("actual_effort_minutes")
  // 2단계가 처음 만들어준 자동초안 원문(사용자가 실제로 고쳐 쓴 내용과 별개로 보관) — 감사·품질
  // 개선용이며 화면에 상시 노출하지 않는다.
  autoDraftSnapshot String? @map("auto_draft_snapshot")
  submittedAt DateTime @default(now()) @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, workDate])
  @@index([workDate])
  @@map("daily_work_logs")
}

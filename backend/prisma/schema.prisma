  relatedId  String?       @map("related_id")
  severity   AlertSeverity @default(WARNING)
  createdAt  DateTime      @default(now()) @map("created_at")
  resolvedAt DateTime?     @map("resolved_at")

  @@map("alerts")
}

model PilotGroup {
  id          String   @id @default(uuid())
